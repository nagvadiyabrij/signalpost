# Database
DATABASE_URL=sqlite:///./data/signalpost.db

# API Keys (optional - depends on which sources you use)
OPENAI_API_KEY=
SEARCH_API_KEY=
SEARCH_PROVIDER=

# Request Limits
MAX_REQUESTS=1800
MAX_CONCURRENCY=5
REQUEST_TIMEOUT=15
MAX_RETRIES=2

# Backend
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Environment
ENVIRONMENT=development
